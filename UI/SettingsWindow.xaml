<Window x:Class="OcrTranslator.UI.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aur OCR Translator — Settings" Width="420" SizeToContent="Height" WindowStartupLocation="CenterScreen" Background="#20242B" Foreground="White"><StackPanel Margin="20"><TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/><TextBlock Text="Target language (DeepL code)"/><TextBox x:Name="Target" Margin="0,4,0,12"/><TextBlock Text="Source language (empty = auto-detect)"/><TextBox x:Name="Source" Margin="0,4,0,12"/><TextBlock Text="Opacity"/><Slider x:Name="OpacitySlider" Minimum="0.6" Maximum="1" Margin="0,4,0,12"/><TextBlock Text="DeepL API key"/><PasswordBox x:Name="ApiKey" Margin="0,4,0,16"/><Button Content="Save" Click="Save" Padding="12,6" HorizontalAlignment="Right"/></StackPanel></Window>
